# Copy to .env and fill in. Placeholders only; never commit real values.
DATABASE_URL=postgresql://agrohub:agrohub@localhost:5432/agrohub
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-string
# local | staging | production (defaults to local)
APP_ENV=local
# Optional: leave empty to use the fake email transport
RESEND_API_KEY=
# Optional locally (empty uses the fake in-memory storage). Required in staging and production:
# a private R2/S3 bucket, never public.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Defaults to auto (R2)
STORAGE_REGION=

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String       @id
  name              String
  email             String
  emailVerified     Boolean      @default(false)
  image             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  phone             String
  consentAcceptedAt DateTime
  locale            String       @default("en")
  sessions          Session[]
  accounts          Account[]
  memberships       Membership[]

  phoneConfirmed Boolean @default(false)

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Role {
  FARMER
  OFFICER
  BUYER
  ADMIN
  BOARD_ADMIN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
  LEFT
}

model Membership {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role
  // Null for BUYER, ADMIN, BOARD_ADMIN.
  cooperativeId String?
  cooperative   Cooperative?     @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  status        MembershipStatus @default(ACTIVE)
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())

  // Declared so Prisma does not drop it; the migration creates it as NULLS NOT DISTINCT.
  @@unique([userId, role, cooperativeId], map: "membership_user_role_cooperative_key")
  @@index([userId])
  @@map("membership")
}

enum CooperativeStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

model Cooperative {
  id                   String                @id @default(cuid())
  name                 String
  registrationNumber   String                @unique
  state                String
  lga                  String
  status               CooperativeStatus     @default(PENDING)
  certificateExpiresAt DateTime
  submittedAt          DateTime?
  verifiedAt           DateTime?
  reviewNote           String?
  recipientCode        String?
  accountName          String?
  bankName             String?
  createdAt            DateTime              @default(now())
  memberships          Membership[]
  documents            CooperativeDocument[]
  inviteLinks          InviteLink[]

  @@map("cooperative")
}

enum DocumentKind {
  REGISTRATION_CERTIFICATE
  BYLAWS
  OFFICER_LIST
}

model CooperativeDocument {
  id            String       @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative  @relation(fields: [cooperativeId], references: [id])
  kind          DocumentKind
  storageKey    String
  contentType   String
  sizeBytes     Int
  uploadedBy    String
  createdAt     DateTime     @default(now())

  @@index([cooperativeId])
  @@map("cooperative_document")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// Append-only: a migration trigger rejects UPDATE, DELETE and TRUNCATE.
// actorId is deliberately not a foreign key so user deletion never collides
// with the immutability trigger.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_log")
}

// One row per (job, time slot) that has started. The unique key is what makes
// scheduled jobs safe to run twice; see src/lib/jobs/run-once.ts.
model JobRun {
  id    String   @id @default(cuid())
  key   String   @unique
  ranAt DateTime @default(now())

  @@map("job_run")
}

enum BankOwnerType {
  COOPERATIVE
  FARMER
}

// A requested payout account change. It takes effect 48 hours after email confirmation.
// There is deliberately no account-number column: only Paystack holds it.
// ownerId points at a cooperative or (from Task 8) a farmer profile, so it has no foreign key.
model BankChangeRequest {
  id               String        @id @default(cuid())
  ownerType        BankOwnerType
  ownerId          String
  newRecipientCode String
  newAccountName   String
  newBankName      String
  requestedBy      String
  confirmToken     String        @unique
  confirmedAt      DateTime?
  effectiveAt      DateTime?
  cancelledAt      DateTime?
  appliedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([ownerType, ownerId])
  @@map("bank_change_request")
}

// An officer's shareable link (email null) or a single-use invite bound to one email.
// The migration adds a partial unique index the schema cannot express:
// invite_link_one_open_shareable_key ON (cooperativeId) WHERE email IS NULL AND revokedAt IS NULL.
// Never log a token.
model InviteLink {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  token         String      @unique
  email         String?
  createdBy     String
  revokedAt     DateTime?
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([cooperativeId])
  @@map("invite_link")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String       @id
  name              String
  email             String
  emailVerified     Boolean      @default(false)
  image             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  phone             String
  consentAcceptedAt DateTime
  locale            String       @default("en")
  sessions          Session[]
  accounts          Account[]
  memberships       Membership[]
  farmerProfile     FarmerProfile?
  lots              Lot[]
  offers            Offer[]
  threads           Thread[]
  messages          Message[]

  phoneConfirmed Boolean @default(false)

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Role {
  FARMER
  OFFICER
  BUYER
  ADMIN
  BOARD_ADMIN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
  LEFT
}

model Membership {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role
  // Null for BUYER, ADMIN, BOARD_ADMIN.
  cooperativeId String?
  cooperative   Cooperative?     @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  status        MembershipStatus @default(ACTIVE)
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())

  // Declared so Prisma does not drop it; the migration creates it as NULLS NOT DISTINCT.
  @@unique([userId, role, cooperativeId], map: "membership_user_role_cooperative_key")
  @@index([userId])
  @@map("membership")
}

enum CooperativeStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

model Cooperative {
  id                   String                @id @default(cuid())
  name                 String
  registrationNumber   String                @unique
  state                String
  lga                  String
  status               CooperativeStatus     @default(PENDING)
  certificateExpiresAt DateTime
  submittedAt          DateTime?
  verifiedAt           DateTime?
  reviewNote           String?
  recipientCode        String?
  accountName          String?
  bankName             String?
  // The cooperative's share of each sale in basis points, at most the admin maximum.
  cutBps               Int                   @default(0)
  createdAt            DateTime              @default(now())
  memberships          Membership[]
  documents            CooperativeDocument[]
  inviteLinks          InviteLink[]
  farmerProfiles       FarmerProfile[]
  catalogRequests      CatalogRequest[]
  lots                 Lot[]
  offers               Offer[]
  threads              Thread[]

  @@map("cooperative")
}

enum DocumentKind {
  REGISTRATION_CERTIFICATE
  BYLAWS
  OFFICER_LIST
}

model CooperativeDocument {
  id            String       @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative  @relation(fields: [cooperativeId], references: [id])
  kind          DocumentKind
  storageKey    String
  contentType   String
  sizeBytes     Int
  uploadedBy    String
  createdAt     DateTime     @default(now())

  @@index([cooperativeId])
  @@map("cooperative_document")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// Append-only: a migration trigger rejects UPDATE, DELETE and TRUNCATE.
// actorId is deliberately not a foreign key so user deletion never collides
// with the immutability trigger.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_log")
}

// One row per (job, time slot) that has started. The unique key is what makes
// scheduled jobs safe to run twice; see src/lib/jobs/run-once.ts.
model JobRun {
  id    String   @id @default(cuid())
  key   String   @unique
  ranAt DateTime @default(now())

  @@map("job_run")
}

enum BankOwnerType {
  COOPERATIVE
  FARMER
}

// A requested payout account change. It takes effect 48 hours after email confirmation.
// There is deliberately no account-number column: only Paystack holds it.
// ownerId points at a cooperative or (from Task 8) a farmer profile, so it has no foreign key.
model BankChangeRequest {
  id               String        @id @default(cuid())
  ownerType        BankOwnerType
  ownerId          String
  newRecipientCode String
  newAccountName   String
  newBankName      String
  requestedBy      String
  confirmToken     String        @unique
  confirmedAt      DateTime?
  effectiveAt      DateTime?
  cancelledAt      DateTime?
  appliedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([ownerType, ownerId])
  @@map("bank_change_request")
}

// An officer's shareable link (email null) or a single-use invite bound to one email.
// The migration adds a partial unique index the schema cannot express:
// invite_link_one_open_shareable_key ON (cooperativeId) WHERE email IS NULL AND revokedAt IS NULL.
// Never log a token.
model InviteLink {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  token         String      @unique
  email         String?
  createdBy     String
  revokedAt     DateTime?
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([cooperativeId])
  @@map("invite_link")
}

// One per user: a farmer who leaves and joins again keeps this row, and it moves to the
// new cooperative. Bank data is only the Paystack recipient code and the resolved account
// name; the account number is never stored. Private fields leave the server only through
// src/modules/farmers/views.ts.
model FarmerProfile {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cooperativeId    String
  cooperative      Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  farmSizeHectares Decimal     @db.Decimal(8, 2)
  // Chosen from the board's crop list (Phase 3); see migration farmer_crop_list.
  crops            Crop[]      @relation("FarmerCrops")
  state            String
  lga              String
  recipientCode    String?
  accountName      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([cooperativeId])
  @@map("farmer_profile")
}

// Reference lists kept by board admins. Deactivated, never deleted, because lots and
// price points reference them. nameKey is the normalized name lower-cased, so names are
// unique regardless of case and spacing.
model Crop {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prices    PricePoint[]
  farmers   FarmerProfile[] @relation("FarmerCrops")
  lots      Lot[]

  @@map("crop")
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prices    PricePoint[]
  lots      Lot[]

  @@map("unit")
}

// One board price per crop, unit, market and week. weekOf is the Monday of the Lagos week.
// marketKey is the normalized market name lower-cased; market is the latest spelling, for
// display. recordedByUserId is not a foreign key, like AuditLog.actorId, so deleting a user
// on request never touches the board.
model PricePoint {
  id               String   @id @default(cuid())
  cropId           String
  crop             Crop     @relation(fields: [cropId], references: [id], onDelete: Restrict)
  unitId           String
  unit             Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  market           String
  marketKey        String
  weekOf           DateTime @db.Date
  priceKobo        Int
  recordedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([cropId, unitId, marketKey, weekOf])
  @@index([weekOf])
  @@map("price_point")
}

// Platform settings an admin can change (architecture section 5). value is a string holding
// integer basis points ("300"); src/lib/money.ts parseBps is the only place it becomes a
// number. A missing row means the default in src/modules/settings/service.ts.
model Setting {
  key             String   @id
  value           String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  @@map("setting")
}

enum CatalogKind {
  CROP
  UNIT
}

enum CatalogRequestStatus {
  WITH_OFFICER
  FORWARDED
  DECLINED
  APPROVED
}

// A farmer's request for a crop or unit missing from the board's list. Their officer
// forwards it (or declines it, or matches it to an item already listed); a board admin then
// adds the item. resolvedItemId is a crop or unit id, so it has no foreign key.
model CatalogRequest {
  id                String               @id @default(cuid())
  kind              CatalogKind
  name              String
  nameKey           String
  cooperativeId     String
  cooperative       Cooperative          @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  requestedByUserId String
  status            CatalogRequestStatus @default(WITH_OFFICER)
  declineReason     String?
  declinedBy        String?
  resolvedItemId    String?
  forwardedByUserId String?
  decidedByUserId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([cooperativeId, status])
  @@index([status, kind, nameKey])
  @@map("catalog_request")
}

enum LotStatus {
  PENDING_REVIEW
  COUNTERED
  REJECTED
  LIVE
  WITHDRAWN
  EXPIRED
  SOLD_OUT
}

enum LotGrade {
  A
  B
  C
  UNGRADED
}

enum Deviation {
  OK
  HIGH
  LOW
}

// A farmer's harvest offered through their cooperative. floorKobo is the farmer's private
// lowest price: it leaves the server only through src/modules/catalog/views.ts mappers that
// buyers never see. quotedCutBps and quotedFeeBps are the terms the farmer was shown at
// submission; approval locks exactly those into LotFeeTerms. availableUntil is a Lagos date.
model Lot {
  id               String            @id @default(cuid())
  cooperativeId    String
  cooperative      Cooperative       @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  farmerUserId     String
  farmer           User              @relation(fields: [farmerUserId], references: [id], onDelete: Restrict)
  cropId           String
  crop             Crop              @relation(fields: [cropId], references: [id], onDelete: Restrict)
  unitId           String
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  quantity         Int
  grade            LotGrade
  pickupState      String
  pickupLga        String
  pickupNote       String?
  askKobo          Int
  floorKobo        Int
  note             String?
  deviation        Deviation?
  quotedCutBps     Int
  quotedFeeBps     Int
  status           LotStatus         @default(PENDING_REVIEW)
  availableUntil   DateTime          @db.Date
  minOrderQty      Int               @default(1)
  counterAskKobo   Int?
  counterMessage   String?
  rejectionReason  String?
  screenedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contributions    LotContribution[]
  photos           LotPhoto[]
  feeTerms         LotFeeTerms?
  revisions        LotRevision[]
  offers           Offer[]
  threads          Thread[]

  @@index([cooperativeId, status])
  @@index([status, availableUntil])
  @@index([farmerUserId])
  @@map("lot")
}

// Which farmer contributed what quantity to a lot; Phase 5 apportions payouts by it.
model LotContribution {
  id           String @id @default(cuid())
  lotId        String
  lot          Lot    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  farmerUserId String
  quantity     Int

  @@unique([lotId, farmerUserId])
  @@map("lot_contribution")
}

// Photos live in the private bucket and are shown only through short-lived signed links.
model LotPhoto {
  id          String @id @default(cuid())
  lotId       String
  lot         Lot    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  storageKey  String
  contentType String
  sizeBytes   Int
  position    Int

  @@unique([lotId, position])
  @@map("lot_photo")
}

// The cut and fee locked to a lot when it goes live. Later changes apply only to new lots.
model LotFeeTerms {
  id                String   @id @default(cuid())
  lotId             String   @unique
  lot               Lot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  cooperativeCutBps Int
  platformFeeBps    Int
  lockedAt          DateTime

  @@map("lot_fee_terms")
}

enum RevisionStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

// A farmer's change to a live lot's price, quantity or floor. The live version stays until
// an officer approves it (spec 14); the lot's locked fee terms never change.
model LotRevision {
  id               String         @id @default(cuid())
  lotId            String
  lot              Lot            @relation(fields: [lotId], references: [id], onDelete: Restrict)
  askKobo          Int
  quantity         Int
  floorKobo        Int
  note             String?
  deviation        Deviation?
  status           RevisionStatus @default(PENDING)
  reason           String?
  screenedByUserId String?
  createdAt        DateTime       @default(now())
  decidedAt        DateTime?

  @@index([lotId, status])
  @@map("lot_revision")
}

enum OfferStatus {
  OPEN
  AWAITING_FARMER
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

// A buyer's offer on a live lot; every kobo value is per unit. Buyers never see the status
// AWAITING_FARMER (an officer referred a below-floor offer to the farmer): their view reads
// it as waiting, with the same expiresAt. An accepted offer holds its quantity until payByAt.
model Offer {
  id               String      @id @default(cuid())
  lotId            String
  lot              Lot         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  cooperativeId    String
  cooperative      Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  buyerUserId      String
  buyer            User        @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  quantity         Int
  offeredKobo      Int
  counterKobo      Int?
  agreedKobo       Int?
  status           OfferStatus @default(OPEN)
  expiresAt        DateTime
  acceptedAt       DateTime?
  payByAt          DateTime?
  referredByUserId String?
  decidedByUserId  String?
  decidedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([lotId, status])
  @@index([cooperativeId, status])
  @@index([buyerUserId, createdAt])
  @@index([status, expiresAt])
  @@map("offer")
}

enum ThreadKind {
  BUYER_COOPERATIVE
  FARMER_COOPERATIVE
}

enum MessageSide {
  BUYER
  COOPERATIVE
  FARMER
  ADMIN
}

// A message thread tied to a lot: a buyer and the cooperative (one per lot and buyer), or the
// lot's farmer and the cooperative's officers (one per lot). counterpartUserId is the buyer or
// the farmer; admins may read and write in any thread. Orders get threads in Phase 5.
model Thread {
  id                String      @id @default(cuid())
  kind              ThreadKind
  lotId             String
  lot               Lot         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  cooperativeId     String
  cooperative       Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  counterpartUserId String
  counterpart       User        @relation(fields: [counterpartUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())
  lastMessageAt     DateTime    @default(now())
  messages          Message[]

  @@unique([lotId, kind, counterpartUserId])
  @@index([cooperativeId, lastMessageAt])
  @@index([counterpartUserId, lastMessageAt])
  @@map("thread")
}

// Plain text, 1 to 2000 characters, never holding a phone number or email address.
model Message {
  id           String      @id @default(cuid())
  threadId     String
  thread       Thread      @relation(fields: [threadId], references: [id], onDelete: Restrict)
  authorUserId String
  author       User        @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  side         MessageSide
  body         String
  createdAt    DateTime    @default(now())

  @@index([threadId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("message")
}

enum NameSubjectType {
  USER
  COOPERATIVE
}

enum NameChangeStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum NameDocumentKind {
  AFFIDAVIT
  MARRIAGE_CERTIFICATE
  PUBLIC_NOTICE
  AMENDED_REGISTRATION_CERTIFICATE
}

// A request to change User.name (subjectType USER, subjectId = User.id) or a verified
// cooperative's name (COOPERATIVE, subjectId = Cooperative.id). No foreign keys: the subject
// is polymorphic, like BankChangeRequest's owner. The migration adds a partial unique index
// the schema cannot express, so each subject has at most one PENDING request:
// name_change_request_one_pending_key ON (subjectType, subjectId) WHERE status = 'PENDING'.
// storageKey points into the private bucket and never leaves the server.
model NameChangeRequest {
  id                String           @id @default(cuid())
  subjectType       NameSubjectType
  subjectId         String
  fromName          String
  toName            String
  reason            String
  documentKind      NameDocumentKind
  storageKey        String
  contentType       String
  sizeBytes         Int
  status            NameChangeStatus @default(PENDING)
  requestedByUserId String
  decidedByUserId   String?
  rejectionReason   String?
  decidedAt         DateTime?
  createdAt         DateTime         @default(now())

  @@index([status, createdAt])
  @@index([subjectType, subjectId])
  @@map("name_change_request")
}
